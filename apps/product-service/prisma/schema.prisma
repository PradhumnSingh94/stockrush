// Product Service owns authoritative catalog and inventory data.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id              String   @id @default(uuid())
  name            String
  description     String?
  price           Decimal  @db.Decimal(10, 2)
  stock           Int      @default(0)
  flashSaleEndsAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("products")
}

enum ReservationStatus {
  RESERVED
  RELEASED
}

model StockReservation {
  id          String                 @id
  orderId     String                 @unique(map: "stock_reservation_orderId_key")
  requestHash String
  status      ReservationStatus      @default(RESERVED)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  items       StockReservationItem[]

  @@map("stock_reservation")
}

model StockReservationItem {
  id            String           @id @default(uuid())
  reservationId String
  productId     String
  productName   String
  unitPrice     Decimal          @db.Decimal(10, 2)
  quantity      Int
  reservation   StockReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@unique([reservationId, productId], map: "stock_reservation_item_reservationId_productId_key")
  @@map("stock_reservation_item")
}
